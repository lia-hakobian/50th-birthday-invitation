
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>50th Birthday Invitation</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #171411;
      color: #f3dfad;
      font-family: Georgia, serif;
      text-align: center;
    }
    .card {
      padding: 50px 25px;
      border: 1px solid #c6a76b;
      margin: 20px;
      max-width: 420px;
      width: 100%;
      box-sizing: border-box;
    }
    .number {
      font-size: 90px;
      margin: 15px 0;
    }
    p { color: #eee0c8; line-height: 1.7; }
    #timer { font-size: 18px; margin-top: 30px; }
  </style>
</head>
<body>
  <div class="card">
    <p>YOU ARE CORDIALLY INVITED TO</p>
    <h1>A Golden Celebration</h1>
    <div class="number">50</div>
    <p>A special birthday deserves a special celebration.</p>
    <p>AN EVENING TO REMEMBER</p>
    <div id="timer">Countdown loading...</div>
  </div>

  <script>
    // Test countdown: 30 days from now
    const partyDate = new Date();
    partyDate.setDate(partyDate.getDate() + 30);

    function updateTimer() {
      const now = new Date();
      const diff = partyDate - now;
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      const minutes = Math.floor((diff % 3600000) / 60000);
      const seconds = Math.floor((diff % 60000) / 1000);

      document.getElementById("timer").textContent =
        `${days} days · ${hours} hours · ${minutes} min · ${seconds} sec`;
    }

    updateTimer();
    setInterval(updateTimer, 1000);
  </script>
</body>
</html>
